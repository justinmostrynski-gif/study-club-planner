// Cloudflare deployment settings for the hosted team planner.
// Cloudflare reads this file every time it deploys the repo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-club-planner",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // The app itself. The Worker runs first so it can check the team passcode.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // The shared team database. Leave database_id out on the first deploy and
  // Cloudflare creates the database automatically. See README if it doesn't.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-club-planner-db"
    }
  ],
  "observability": { "enabled": true }
}
